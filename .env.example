# Base de données
DB_NAME=emeres

# Clé de signature JWT (obligatoire en production)
SECRET_KEY=change-me-in-production

# Mode développement (désactive certaines vérifications)
DEV_MODE=true

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8001

# Fournisseur LLM : stub (par défaut, sans clé) | openai | ollama
LLM_PROVIDER=stub
LLM_MODEL=llama3.1

# E-mail (SMTP) — optionnel en développement
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@emeres.fr
